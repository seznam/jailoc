# Generated by jailoc — do not edit manually
name: jailoc-{{.WorkspaceName}}

services:
  opencode:
    image: {{.Image}}
{{- if .FilteredDNS}}
    dns:
      - 169.254.53.53
    depends_on:
      - dnsfilter
{{- end}}
{{- if .ExposePort}}
    ports:
      - "127.0.0.1:{{.Port}}:4096"
{{- end}}
    volumes:
{{- range .Paths}}
      - {{.}}:{{. | containerPath}}
{{- end}}
{{- if .UseDataVolume}}
      - opencode-data-{{.WorkspaceName}}:/home/agent/.local/share/opencode
{{- end}}
{{- if .UseCacheVolume}}
      - opencode-cache-{{.WorkspaceName}}:/home/agent/.cache
{{- end}}
{{- range .Mounts}}
      - {{.}}
{{- end}}
      - ${HOME}/.config/jailoc/workspaces/{{.WorkspaceName}}:/etc/jailoc:ro
      - ${HOME}/.cache/jailoc/{{.WorkspaceName}}/entrypoint.sh:/usr/local/bin/entrypoint.sh:ro
      - ${HOME}/.cache/jailoc/tui-container.json:/etc/jailoc-tui.json:ro
      - ${HOME}/.cache/jailoc/tui-plugin:/etc/jailoc-tui-plugin:ro
{{- if .EnableDocker}}
      - dind-certs-client:/certs/client:ro
{{- end}}
{{- if .SSHAuthSock}}
      - {{.SSHAuthSock}}:/run/ssh-agent.sock
{{- end}}
{{- if .GitConfig}}
      - {{.GitConfig}}:/home/agent/.gitconfig:ro
{{- end}}
{{- if .SSHKnownHosts}}
      - {{.SSHKnownHosts}}:/home/agent/.ssh/known_hosts:ro
{{- end}}
    environment:
      - OPENCODE_LOG=debug
      - OPENCODE_SERVER_PASSWORD=${OPENCODE_SERVER_PASSWORD}
{{- if .EnableDocker}}
      - DOCKER_HOST=tcp://dind:2376
      - DOCKER_TLS_CERTDIR=/certs
      - DOCKER_CERT_PATH=/certs/client
      - DOCKER_TLS_VERIFY=1
{{- end}}
      - JAILOC=1
      - JAILOC_WORKSPACE={{.WorkspaceName}}
{{- if .FilteredDNS}}
      - JAILOC_FILTERED_DNS=1
{{- end}}
{{- if .SSHAuthSock}}
      - SSH_AUTH_SOCK=/run/ssh-agent.sock
{{- end}}
{{- range .Env}}
      - {{. | yamlQuote}}
{{- end}}
{{- if .Secrets}}
    secrets:
{{- range .Secrets}}
      - {{.Name | yamlQuote}}
{{- end}}
{{- end}}
    cap_drop:
      - ALL
    cap_add:
      - NET_BIND_SERVICE  # bind to port 4096
      - NET_ADMIN         # iptables network restrictions
      - SETUID            # setpriv privilege drop
      - SETGID            # setpriv privilege drop
      - CHOWN             # chown data dirs before drop
      - FOWNER            # bypass ownership checks on chown
      - DAC_READ_SEARCH   # traverse restricted dirs during chown
    stdin_open: true
    tty: true
    mem_limit: "{{.Memory}}"
    memswap_limit: "{{.Memory}}"
    mem_reservation: 512m
    cpus: {{printf "%g" .CPU}}
    pids_limit: 256
    networks:
      jailoc:
{{- if .FilteredDNS}}
        link_local_ips:
          - 169.254.53.2
{{- end}}
    entrypoint: ["/usr/local/bin/entrypoint.sh"]
    command: ["opencode", "serve", "--hostname", "0.0.0.0", "--port", "4096", "--print-logs", "--log-level", "DEBUG"]
{{- if .Paths}}
    working_dir: {{index .Paths 0 | containerPath}}
{{- end}}
    healthcheck:
      test: ["CMD-SHELL", "curl -sf -u \"opencode:$$OPENCODE_SERVER_PASSWORD\" http://localhost:4096/global/health || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 60s
{{- if .EnableDocker}}

  dind:
    image: docker:dind-rootless
{{- if .FilteredDNS}}
    dns:
      - 169.254.53.53
    depends_on:
      - dnsfilter
{{- end}}
    user: "0:0"
    privileged: true
    entrypoint: ["/usr/local/bin/dind-entrypoint.sh"]
    environment:
      - DOCKER_TLS_CERTDIR=/certs
      - DOCKER_TLS_SAN=DNS:dind
{{- if .FilteredDNS}}
      - JAILOC_FILTERED_DNS=1
{{- end}}
    volumes:
      - dind-certs-ca:/certs/ca
      - dind-certs-client:/certs/client
      - dind-data:/home/rootless/.local/share/docker
      - dind-storage-meta:/var/lib/jailoc/storage
      - ${HOME}/.cache/jailoc/{{.WorkspaceName}}/dind-entrypoint.sh:/usr/local/bin/dind-entrypoint.sh:ro
      - ${HOME}/.config/jailoc/workspaces/{{.WorkspaceName}}:/etc/jailoc:ro
    networks:
      jailoc:
{{- if .FilteredDNS}}
        link_local_ips:
          - 169.254.53.3
{{- end}}
    expose:
      - "2376"
{{- end}}
{{- if .FilteredDNS}}

  dnsfilter:
    image: coredns/coredns:1.12.4
    command: ["-conf", "/etc/coredns/Corefile"]
    volumes:
      - ${HOME}/.cache/jailoc/{{.WorkspaceName}}/Corefile:/etc/coredns/Corefile:ro
    cap_drop:
      - ALL
    cap_add:
      - NET_BIND_SERVICE
    security_opt:
      - no-new-privileges:true
    read_only: true
    networks:
      jailoc:
        link_local_ips:
          - 169.254.53.53
{{- end}}

{{- if or .UseDataVolume .UseCacheVolume .EnableDocker}}

volumes:
{{- if .UseDataVolume}}
  opencode-data-{{.WorkspaceName}}:
{{- end}}
{{- if .UseCacheVolume}}
  opencode-cache-{{.WorkspaceName}}:
{{- end}}
{{- if .EnableDocker}}
  dind-certs-ca:
  dind-certs-client:
  dind-data:
  dind-storage-meta:
{{- end}}
{{- end}}

networks:
  jailoc:
{{- if .Secrets}}

secrets:
{{- range .Secrets}}
  {{.Name | yamlQuote}}:
{{- if .Environment}}
    environment: {{.Environment | yamlQuote}}
{{- end}}
{{- if .File}}
    file: {{.File | yamlQuote}}
{{- end}}
{{- end}}
{{- end}}
