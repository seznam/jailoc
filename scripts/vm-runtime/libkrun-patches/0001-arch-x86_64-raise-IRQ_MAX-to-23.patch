From f5fc9f253c36f15c73a6b3a14f62228c79e74d48 Mon Sep 17 00:00:00 2001
From: Jake Correnti <jakecorrenti+github@proton.me>
Date: Fri, 11 Sep 2026 15:25:03 -0400
Subject: [PATCH] arch/x86_64: raise IRQ_MAX to 23 for expanded IOAPIC range

The I/O APIC has 24 pins. Leave ISA IRQs 0-4 for legacy devices and
expose GSIs 5-23 for virtio-mmio.

Assisted-by: Cursor: grok-4.6
Signed-off-by: Jake Correnti <jakecorrenti+github@proton.me>
---
 src/arch/src/x86_64/layout.rs | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/src/arch/src/x86_64/layout.rs b/src/arch/src/x86_64/layout.rs
index a52285d221..4f5bbd842f 100644
--- a/src/arch/src/x86_64/layout.rs
+++ b/src/arch/src/x86_64/layout.rs
@@ -22,11 +22,12 @@ pub const INITRD_SEV_START: u64 = 0xa00000;
 /// Start of the high memory.
 pub const HIMEM_START: u64 = 0x0010_0000; //1 MB.
 
-// Typically, on x86 systems 16 IRQs are used (0-15).
+// The I/O APIC has 24 pins (0-23). ISA IRQs 0-4 are reserved for
+// legacy devices, leaving GSIs 5-23 for virtio-mmio devices.
 /// First usable IRQ ID for virtio device interrupts on x86_64.
 pub const IRQ_BASE: u32 = 5;
 /// Last usable IRQ ID for virtio device interrupts on x86_64.
-pub const IRQ_MAX: u32 = 15;
+pub const IRQ_MAX: u32 = 23;
 
 /// Address for the TSS setup.
 pub const KVM_TSS_ADDRESS: u64 = 0xfffb_d000;
